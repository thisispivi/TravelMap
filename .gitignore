# Local assistant tooling and launch settings.
.github/skills/
.agents
.claude/launch.json
.claude/settings.local.json
apps/travel-map/.claude/launch.json
apps/travel-map/.claude/settings.local.json

# Dependencies and build output.
node_modules/
dist/
test-results/

# Personal travel data. The repo ships with an empty data/ so a fork starts
# from scratch; the editor (apps/travel-map-editor) creates this as you add
# countries, cities, and trips.
/data/*
!/data/README.md

# Generated and self-hosted photo assets stay local or in the mounted volume.
/media/

# Editor backups of data/. Local safety net, never shared.
/.data-snapshots/

# Test and tool caches are reproducible local state.
coverage/
.vite/
*.tsbuildinfo
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
.env
.env.*
!.env.example
!/scripts/uploader/env/example.env
/scripts/uploader/photos/*
!/scripts/uploader/photos/.gitignore
/scripts/uploader/*.json

# Python virtual environments and bytecode caches.
.venv/
venv/
__pycache__/
