{
  "name": "travel-map",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "homepage": "https://map.pivi.dev",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "emblems": "node scripts/emblems.ts",
    "knip": "knip",
    "lint": "eslint . --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "preview": "vite preview",
    "react:doctor": "react-doctor . --verbose",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "update:packages": "ncu -u --peer --reject prettier,eslint,@eslint/js,typescript",
    "deploy:pages": "node scripts/check-release.mjs && pnpm run build && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "@travelmap/core": "workspace:*",
    "@travelmap/ui": "workspace:*",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-map-gl": "^8.1.3",
    "react-photo-album": "^3.6.2",
    "react-router": "^8.5.1",
    "remeda": "^2.61.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "gh-pages": "^6.3.0",
    "i18next": "^27.1.3",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "npm-check-updates": "^23.1.1",
    "react-doctor": "^0.9.23",
    "sass": "^1.108.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "browserslist": {
    "production": [
      ">0.01%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.01%",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
