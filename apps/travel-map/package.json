{
  "name": "travel-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://map.pivi.dev",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm react:doctor",
    "lint": "eslint . --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "prepare": "cd ../.. & husky",
    "format": "prettier . ../../packages ../../apps/travel-map-editor ../../docs ../../data/site.config.json ../../README.md ../../AGENTS.md ../../CLAUDE.md ../../CODING_GUIDELINES.md ../../.github/copilot-instructions.md --write",
    "format:check": "prettier . ../../packages ../../apps/travel-map-editor ../../docs ../../data/site.config.json ../../README.md ../../AGENTS.md ../../CLAUDE.md ../../CODING_GUIDELINES.md ../../.github/copilot-instructions.md --check",
    "predeploygh": "pnpm run build",
    "deploygh": "gh-pages -d dist --nojekyll",
    "update:packages": "ncu -u --peer --reject prettier,eslint,@eslint/js,typescript",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "security:audit": "pnpm audit --audit-level=low",
    "react:doctor": "react-doctor . --verbose",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@travelmap/core": "workspace:*",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "maplibre-gl": "5.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-image-gallery": "^2.1.2",
    "react-map-gl": "^8.1.2",
    "react-photo-album": "^3.6.1",
    "react-router": "^8.3.0",
    "remeda": "^2.39.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "npm-check-updates": "^23.0.1",
    "postcss": "8.5.25",
    "prettier": "3.9.5",
    "react-doctor": "^0.9.4",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix --max-warnings=0",
    "*.{js,mjs,cjs,ts,tsx,css,scss,md,html,json,yaml,yml}": "prettier --write"
  },
  "browserslist": {
    "production": [
      ">0.01%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.01%",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
