{
  "name": "travel-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://map.pivi.dev",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "build": "tsc && vite build",
    "deploygh": "gh-pages -d dist --nojekyll",
    "dev": "vite",
    "knip": "knip",
    "lint": "eslint . --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "predeploygh": "pnpm run build",
    "preview": "vite preview",
    "react:doctor": "react-doctor . --verbose",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "update:packages": "ncu -u --peer --reject prettier,eslint,@eslint/js,typescript"
  },
  "dependencies": {
    "@travelmap/core": "workspace:*",
    "@travelmap/ui": "workspace:*",
    "framer-motion": "^13.5.1",
    "i18next": "^26.5.5",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "6.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.2",
    "react-map-gl": "^8.1.3",
    "react-photo-album": "^3.6.2",
    "react-router": "^8.5.0",
    "remeda": "^2.53.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "gh-pages": "^6.3.0",
    "knip": "^6.42.1",
    "npm-check-updates": "^23.1.1",
    "react-doctor": "^0.9.18",
    "sass": "^1.106.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.12"
  },
  "browserslist": {
    "production": [
      ">0.01%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.01%",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
