VITE_CDN_PATH="/media"
VITE_YOUTUBE_PATH="https://youtube.com/embed/"
# Future trips are only exposed by the public app while Vite is in dev mode.
VITE_SHOW_FUTURE_TRIPS="false"

# Editor uploads to Bunny Storage. Read by the editor's dev server only — no
# VITE_ prefix, so none of these ever reach a browser. Leave the key empty to
# upload to the local media/ folder instead.
CDN_STORAGE_ZONE_NAME=""
CDN_STORAGE_ZONE_REGION=""
CDN_STORAGE_ZONE_API_KEY=""
CDN_BASE_STORAGE_PATH="Travels"

# Encoding targets in KB and pixels, matching the old Python uploader.
THUMBNAIL_MIN_SIZE=70
THUMBNAIL_MAX_SIZE=250
THUMBNAIL_RESOLUTION=900
COMPRESSED_MIN_SIZE=750
COMPRESSED_MAX_SIZE=1500
COMPRESSED_RESOLUTION=2000
